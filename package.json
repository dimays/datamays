{
  "name": "datamays-site",
  "private": true,
  "devDependencies": {
    "@tailwindcss/forms": "*",
    "@tailwindcss/typography": "*",
    "alpinejs": "^3.15.12",
    "htmx.org": "^2.0.10",
    "tailwindcss": "^3.4.14"
  },
  "scripts": {
    "tailwind:build": "npx tailwindcss -i assets/css/input.css -o static/css/tailwind.css",
    "tailwind:watch": "npx tailwindcss -i assets/css/input.css -o static/css/tailwind.css --watch",
    "vendor:js": "cp node_modules/htmx.org/dist/htmx.min.js static/js/htmx.min.js && cp node_modules/alpinejs/dist/cdn.min.js static/js/alpine.min.js"
  }
}
